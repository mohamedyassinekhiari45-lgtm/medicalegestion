@startuml
title Partage de dossier médical (propriétaire → collègue)

actor "Médecin A\n(propriétaire)" as MedA
participant "DossierMedical\nController" as DMC
participant "Patient (Model)" as PatM
participant "DossierMedical\n(Model)" as DM
participant "ShareRequest\n(Model)" as SR
participant "User (Model)" as UserM
participant "DemandePartage\n(Notification)" as NotifDP

== Consultation du dossier ==
MedA -> DMC: GET /patients/{patient}/dossier
DMC -> DM: firstOrCreate(patient_id)
DMC -> DM: load('authorizations.medecin.specialites', ...)
DMC -> DMC: Calcule $medecinsAutorisables, $shareRequests, $sentRequests, $requestableMedecins
DMC --> MedA: Page dossier médical

== Partage (sélection checkboxes) ==
MedA -> DMC: POST /patients/{patient}/dossier/partager\n(to_medecin_id, notes_partagees=[...], documents_partagees=[...])

DMC -> DMC: Vérifie que MedA a traité ce patient
DMC -> UserM: findOrFail(to_medecin_id)
alt destinataire non médecin
    DMC --> MedA: back() "Vous ne pouvez partager qu'avec un médecin."
else partage avec soi-même
    DMC --> MedA: back() "Vous ne pouvez pas partager avec vous-même."
else autorisation déjà existante
    DMC -> DM: authorizations()->where('medecin_id',$id)->where('autorise_par',Auth::id())->exists()
    DMC --> MedA: back() "Ce médecin a déjà accès à votre section."
else demande en attente
    DMC -> SR: where('from_medecin_id',Auth::id())->where('to_medecin_id',$id)->where('statut','en_attente')->exists()
    DMC --> MedA: back() "Une demande est déjà en attente."
else
    DMC -> SR: create(dossier_medical_id, from=MedA, to=MedB,\n  requester=MedA, notes/documents, statut='en_attente')
    SR --> DMC: $shareRequest
    DMC -> NotifDP: notify(MedB)  "Dr MedA souhaite partager des éléments..."
    DMC --> MedA: back() "Demande de partage envoyée à Dr MedB."
end

@enduml
