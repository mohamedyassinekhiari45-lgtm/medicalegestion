@startuml
title Demande d'accès au dossier médical (collègue → propriétaire)

actor "Médecin B\n(demandeur)" as MedB
participant "Patient (Model)" as PatM
participant "DossierMedical\nController" as DMC
participant "DossierMedical\n(Model)" as DM
participant "ShareRequest\n(Model)" as SR
participant "User (Model)" as UserM
participant "DemandePartage\n(Notification)" as NotifDP
participant "DemandeAnnulee\n(Notification)" as NotifDA

note right of MedB
  Il n'existe plus de partage direct :
  le partage passe obligatoirement
  par une demande, puis une décision
  du propriétaire de la section.
end note

== Consultation du dossier ==
MedB -> DMC: GET /patients/{patient}/dossier
DMC -> PatM: estTraitePar(Auth::id())
alt MedB n'a pas pris ce patient en charge
    PatM --> DMC: false
    DMC --> MedB: refuserAcces()
else
    PatM --> DMC: true
    DMC -> DM: firstOrCreate(patient_id)
    DMC -> DMC: Calcule $requestableMedecins\n= tous les autres medecins traitants,\nmoins ceux qui m'ont deja autorise\net ceux a qui j'ai deja demande
    DMC --> MedB: page du dossier\n+ section "Accès au dossier"
end

== Demande d'accès avec périmètre ==
MedB -> DMC: POST /patients/{patient}/dossier/demander-acces\n(medecin_id = propriétaire,\n notes = checkbox, documents = checkbox)

DMC -> PatM: estTraitePar(Auth::id())
alt MedB n'est pas médecin traitant
    PatM --> DMC: false
    DMC --> MedB: refuserAcces()
else
    PatM --> DMC: true
    DMC -> UserM: findOrFail(medecin_id)
    alt destinataire non médecin
        DMC --> MedB: back() "Vous ne pouvez demander l'accès qu'à un médecin."
    else demande envers soi-même
        DMC --> MedB: back() "Vous ne pouvez pas vous demander l'accès à vous-même."
    else notes ET documents non cochés
        DMC --> MedB: back() "Sélectionnez au moins un élément :\nles notes, les documents, ou les deux."
    else déjà autorisé
        DMC -> DM: authorizations()->where('medecin_id',MedB)\n->where('autorise_par',$id)->exists()
        DMC --> MedB: back() "Vous avez déjà accès à la section de ce médecin."
    else demande déjà en attente
        DMC -> SR: where('from_medecin_id',$id)\n->where('to_medecin_id',MedB)\n->where('statut','en_attente')->exists()
        DMC --> MedB: back() "Une demande est déjà en attente."
    else
        note right of DMC
          notes=1, documents=0 -> Notes seules
          notes=0, documents=1 -> Documents seuls
          notes=1, documents=1 -> Les deux
        end note
        DMC -> SR: create(dossier_medical_id,\n  from=MedA, to=MedB,\n  requester=MedB,\n  notes_partagees, documents_partagees,\n  statut='en_attente')
        SR --> DMC: $shareRequest
        DMC -> NotifDP: notify(MedA)\n"Dr MedB demande l'accès à ses notes\net/ou documents dans votre section"
        DMC --> MedB: back() "Demande d'accès aux [périmètre]\ndu Dr MedA envoyée."
    end
end

== Annulation de la demande par le demandeur ==
MedB -> DMC: DELETE /partages/{shareRequest}/annuler
alt MedB n'est pas le demandeur
    DMC --> MedB: back() "Vous ne pouvez annuler que\nles demandes que vous avez envoyées."
else demande déjà traitée
    DMC --> MedB: back() "Cette demande a déjà été traitée."
else
    DMC -> SR: update(statut='annulee')
    DMC -> NotifDA: notify(MedA)\n"Dr MedB a annulé sa demande"
    DMC --> MedB: "Demande d'accès annulée."
end

note right of SR
  Le périmètre demandé est mémorisé dans
  share_requests.notes_partagees et
  documents_partagees (valeurs booléennes).
  L'acceptation reprend exactement ce périmètre.
end note

@enduml